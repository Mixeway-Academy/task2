          "ruleId": "GHSA-f8q6-p94x-37v3",
          "level": "warning",
          "message": {
            "text": "GHSA-f8q6-p94x-37v3 - A vulnerability was found in the minimatch package. This flaw allows a Regular Expression Denial of Service (ReDoS) when calling the braceExpand function with specific arguments, resulting in a Denial of Service."
          },
          "partialFingerprints": {
            "vulnerabilityHash": "6f082379735a1a99c8fe36deb90e7a56"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "file://\/src\/src\/main\/resources\/static\/vendors\/jquery-mask\/package-lock.json?minimatch"
                  ,"index": 36
                }
