                  ,"index": 33
                }
              }
                ,"logicalLocations": [
                    {
                    "fullyQualifiedName": "pkg:npm\/js-yaml@3.13.1"
                    }
                ]
              
            }
          ]
          }, {
          "ruleId": "GHSA-896r-f27r-55mw",
          "level": "warning",
          "message": {
            "text": "GHSA-896r-f27r-55mw - json-schema before version 0.4.0 is vulnerable to Improperly Controlled Modification of Object Prototype Attributes ('Prototype Pollution')."
          },
          "partialFingerprints": {
            "vulnerabilityHash": "85ca4d5e7885b90e8c66e39b7d9a0efa"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "file://\/src\/src\/main\/resources\/static\/vendors\/jquery-mask\/package-lock.json?json-schema"
                  ,"index": 34
                }
