          "level": "warning",
          "message": {
            "text": "GHSA-7pqw-9j4j-h8q3 - extract-zip through 2.0.1 containment-checks only the parent directory of each archive entry and never the entry's own final path component, so an archive containing two entries with identical names - a symlink whose target is outside the destination, followed by a regular file - writes through the planted symlink and yields an arbitrary file write outside the destination directory."
          },
          "partialFingerprints": {
            "vulnerabilityHash": "673bf15097355deb5da4bdef685a45aa"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "file://\/src\/src\/main\/resources\/static\/vendors\/jquery-mask\/package-lock.json?extract-zip"
                  ,"index": 20
                }
              }
                ,"logicalLocations": [
